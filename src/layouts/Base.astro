---
import '../styles/global.css';
import { DASH_DEFS } from '../lib/art';
import { formaClipCss } from '../lib/palette';
import event from '../data/event.json';
import CookieBanner from '../components/CookieBanner.astro';
import fcBase from '../../brand/fonts/flutterchicha/FlutterChicha-Regular.woff2?url';
import fcSombra from '../../brand/fonts/flutterchicha/FlutterChichaSombra-Regular.woff2?url';
import { fontFaceCss, hasMonchila, webFonts } from '../lib/monchila';

/** `lettering`: the heading font the page uses, so only that one is preloaded. "neon" (Monchila, see
 * Neon.astro) falls back to "chicha" (FlutterChicha) when the local Monchila files are missing. */
interface Props { title?: string; description?: string; jsonLd?: boolean; noindex?: boolean; lettering?: 'chicha' | 'neon' }
const {
  title = `${event.name} · ${event.dateLong.split(' de 2026')[0]} · ${event.venue}`,
  jsonLd = true,
  noindex = false,
  lettering = 'chicha',
  description = `Un día entero de Flutter y Dart en Lima: charlas, talleres y comunidad. ${event.dateLong}, ${event.hours}, ${event.venue}.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const neon = lettering === 'neon' && hasMonchila;
const preloads = neon
  ? [webFonts.fill!, webFonts.silhouette!].map((f) => ({ href: f.url, type: `font/${f.format === 'truetype' ? 'ttf' : f.format}` }))
  : [fcBase, fcSombra].map((href) => ({ href, type: 'font/woff2' }));
/** Files under public/ (base-path aware); og:image needs absolute URLs. Images: `npm run social`. */
const asset = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${p}`;
const ogImage = new URL(asset('social/og-1200x630.png'), Astro.site).href;
const ogSquare = new URL(asset('social/og-1200x1200.png'), Astro.site).href;
const ogAlt = `${event.name}: ${event.dateLong}, ${event.venue}, ${event.city}. Dash con la bandera del Perú.`;
const ld = {
  '@context': 'https://schema.org', '@type': 'Event', name: event.name, description,
  startDate: `${event.isoDate}T${event.start}:00-05:00`, endDate: `${event.isoDate}T${event.end}:00-05:00`,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: event.venue, address: { '@type': 'PostalAddress', streetAddress: event.address, addressLocality: 'Magdalena del Mar, Lima', addressCountry: 'PE' } },
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#021C3F" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image" content={ogSquare} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    {preloads.map((f) => <link rel="preload" href={f.href} as="font" type={f.type} crossorigin />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bungee&family=Bungee+Shade&family=Rubik:wght@400;500;600;700;800;900&display=swap" />
    <style is:inline set:html={formaClipCss()}></style>
    {hasMonchila && <style is:inline set:html={fontFaceCss(webFonts)}></style>}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <a class="skip" href="#top">Saltar al contenido</a>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs set:html={DASH_DEFS} /></svg>
    <slot />
    <CookieBanner />
    <script>
      import { boot } from '../scripts/engine';
      import { initAnalytics } from '../scripts/analytics';
      boot();
      initAnalytics();
    </script>
  </body>
</html>
