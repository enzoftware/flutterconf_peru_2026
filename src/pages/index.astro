---
/**
 * Launch landing (November 2026): only the confirmed facts (date and venue), the sign-up form and social links.
 * This is the only page of the site. The full landing (speakers, agenda, tickets) is parked, not routed,
 * in src/pages/_full-landing/ until that content is ready.
 */
import Base from '../layouts/Base.astro';
import KitLayers from '../components/KitLayers.astro';
import LaunchNav from '../components/launch/LaunchNav.astro';
import LaunchHero from '../components/launch/LaunchHero.astro';
import Venue from '../components/launch/Venue.astro';
import SaveDate from '../components/launch/SaveDate.astro';
import Register from '../components/launch/Register.astro';
import Follow from '../components/launch/Follow.astro';
import '../styles/launch.css';
import event from '../data/event.json';
const PEEK = ['¡Hola, causa! Sigue bajando', '¡Mira la vista, pe!', '¿Ya lo anotaste?', '¡Déjame tu correo!', '¡Síguenos, pe!', '¡Nos vemos el 19!'];
---
<Base description={`${event.name}: un día entero de Flutter y Dart. ${event.dateLong}, ${event.hours}, ${event.venue}. Regístrate y te avisamos primero de ponentes y entradas.`}>
  <div class="sc">
    <main class="lp t-m k-forma k-mixta ln" data-t="m">
      <LaunchNav />
      <LaunchHero />
      <Venue />
      <SaveDate />
      <Register />
      <Follow />
      <KitLayers lines={PEEK} gap={0.7} />
    </main>
  </div>
</Base>
