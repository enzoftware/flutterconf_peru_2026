---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import KitLayers from '../components/KitLayers.astro';
import Hero from '../components/Hero.astro';
import Topics from '../components/Topics.astro';
import Speakers from '../components/Speakers.astro';
import Agenda from '../components/Agenda.astro';
import Tickets from '../components/Tickets.astro';
import Community from '../components/Community.astro';
import Sponsors from '../components/Sponsors.astro';
import Faq from '../components/Faq.astro';
---
<Base>
  <div class="sc">
    <main class="lp t-m k-forma k-mixta" data-t="m">
      <Nav />
      <Hero />
      <Topics />
      <Speakers />
      <Agenda />
      <Tickets />
      <Community />
      <Sponsors />
      <Faq />
      <KitLayers />
    </main>
  </div>
</Base>
