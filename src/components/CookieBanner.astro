---
/**
 * Cookie consent for PostHog analytics (see src/scripts/analytics.ts).
 * Shown until the visitor answers; any element with [data-cookie-settings] opens it again.
 * Not rendered at all when PUBLIC_POSTHOG_KEY is empty (no analytics, nothing to ask).
 * Both answers get the same size and weight, so rejecting is as easy as accepting.
 */
import { PUBLIC_POSTHOG_KEY } from 'astro:env/client';
---
{PUBLIC_POSTHOG_KEY && (
  <section class="ck" data-cookies hidden aria-labelledby="ck-t" aria-describedby="ck-d">
    <p class="ck-t" id="ck-t">¿Nos ayudas a medir?</p>
    <p class="ck-d" id="ck-d">
      Usamos cookies de analítica (PostHog) para saber cuántas personas visitan la página y de dónde llegan.
      Nunca guardamos tu nombre ni tu correo ahí. Si las rechazas, solo contamos la visita, sin cookies.
    </p>
    <div class="ck-b">
      <button type="button" class="ck-y" data-consent="yes">Aceptar</button>
      <button type="button" class="ck-n" data-consent="no">Rechazar</button>
    </div>
  </section>
)}

<style>
  .ck{
    position:fixed; z-index:80; left:16px; bottom:16px; width:min(420px, calc(100% - 32px));
    background:#F3F8FF; color:#021C3F; border:4px solid #021C3F; border-radius:22px;
    box-shadow:8px 8px 0 #F25D50; padding:18px 18px 16px; font:500 14px/1.45 Rubik, system-ui, sans-serif;
    animation:ck-in .35s cubic-bezier(.2,.9,.3,1.3) both;
  }
  .ck[hidden]{ display:none }
  .ck-t{ margin:0 0 6px; font-family:Bungee, system-ui, sans-serif; font-size:16px; letter-spacing:.03em }
  .ck-d{ margin:0 0 14px }
  .ck-b{ display:grid; grid-template-columns:1fr 1fr; gap:10px }
  .ck button{
    min-height:44px; border:3px solid #021C3F; border-radius:999px; cursor:pointer;
    font:400 14px Bungee, system-ui, sans-serif; letter-spacing:.04em;
  }
  .ck-y{ background:#021C3F; color:#FFF275 }
  .ck-n{ background:#fff; color:#021C3F }
  .ck button:focus-visible{ outline:3px solid #0553B1; outline-offset:3px }
  @keyframes ck-in{ from{ translate:0 24px; opacity:0 } }
  @media (prefers-reduced-motion: reduce){ .ck{ animation:none } }
  @media print{ .ck{ display:none } }
</style>

<script>
  import { consent, setConsent, track, type Consent } from '../scripts/analytics';

  const box = document.querySelector<HTMLElement>('[data-cookies]');
  if (box) {
    const show = (focus: boolean) => {
      box.hidden = false;
      if (focus) box.querySelector<HTMLButtonElement>(consent() === 'no' ? '.ck-n' : '.ck-y')?.focus();
    };
    if (!consent()) show(false); // first visit: show without stealing focus from the page

    box.addEventListener('click', (e) => {
      const v = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset.consent as Consent | undefined;
      if (!v) return;
      const changed = consent() !== v;
      setConsent(v);
      if (changed && v === 'yes') track('cookies_accepted');
      box.hidden = true;
    });

    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-cookie-settings]')) show(true);
    });
  }
</script>
