---
/**
 * "Avísame primero": sign-up form. Posts JSON to the Google Apps Script web app in PUBLIC_REGISTER_ENDPOINT
 * (integrations/google-sheets/). Sent as text/plain so the browser skips the CORS preflight Apps Script can't answer.
 * PostHog gets anonymous funnel events only: register_started, register_succeeded, register_failed.
 */
import Chicha from '../Chicha.astro';
import Dash from '../Dash.astro';
import Floater from '../Floater.astro';
import { sparkle, diamond } from '../../lib/art';
const ROLES = [
  ['estudiante', 'Estudiante'],
  ['dev-flutter', 'Dev Flutter o Dart'],
  ['dev-otro', 'Dev de otro stack'],
  ['diseno-producto', 'Diseño o producto'],
  ['lider-empresa', 'Líder o empresa'],
  ['otro', 'Otro'],
];
---
<section class="z rg" id="registro" style="--a:#0553B1;--b:#FFF275;--fg:#021C3F">
  <Floater svg={sparkle('#F25D50')} x="5%" y="520px" w={44} spd={-220} rot={90} />
  <Floater svg={diamond('#6200EE', '#021C3F')} x="90%" y="700px" w={36} spd={-260} rot={-60} />
  <div class="wrap rgg">
    <div class="rgi">
      <span class="kick" data-r="up" style="--kc:#FFF275">Registro</span>
      <h2 data-r="pop"><Chicha text={'¡Avísame\nprimero!'} /></h2>
      <ul class="perks">
        <li data-r="left">Te escribimos apenas abran las <b>entradas</b>.</li>
        <li data-r="left" style="--d:.06s">Conoces a los <b>ponentes</b> antes que nadie.</li>
        <li data-r="left" style="--d:.12s">Te enteras cuando abra el <b>call for papers</b>.</li>
      </ul>
      <p class="nospam" data-r="up">Solo correos de FlutterConf Perú, nada de spam. Puedes darte de baja cuando quieras.</p>
    </div>
    <div class="fcard-w" data-r="zoom">
      <div class="fpeek" aria-hidden="true"><Dash flag={false} /></div>
      <form class="fcard" id="rf" novalidate>
        <div class="fv-ok" hidden tabindex="-1">
          <div class="okd" aria-hidden="true"><Dash /></div>
          <p class="ok-t"><Chicha text="¡Listo!" /></p>
          <p class="ok-m">Ya estás en la lista. Te escribiremos a <b data-ok-email></b> con cada novedad.</p>
          <button type="button" class="bt alt" data-share>Pásale la voz a tu equipo</button>
          <p class="ok-c" data-copied hidden role="status">Enlace copiado</p>
        </div>
        <div class="ff">
          <label class="fl-f"><span>Nombre</span><input name="name" autocomplete="name" required minlength="2" maxlength="80" placeholder="¿Cómo te llamas?" /></label>
          <label class="fl-f"><span>Correo</span><input name="email" type="email" autocomplete="email" inputmode="email" required maxlength="120" placeholder="tu@correo.com" /></label>
          <fieldset class="fl-f roles">
            <legend>¿Cómo te describes?</legend>
            <div>{ROLES.map(([v, l]) => <label class="role"><input type="radio" name="role" value={v} required /><span>{l}</span></label>)}</div>
          </fieldset>
          <label class="fl-f"><span>Ciudad <small>(opcional)</small></span><input name="city" autocomplete="address-level2" maxlength="60" placeholder="Lima" /></label>
          <label class="hp" aria-hidden="true">Sitio web<input name="website" tabindex="-1" autocomplete="off" /></label>
          <label class="consent"><input type="checkbox" name="consent" required /><span>Acepto recibir correos sobre FlutterConf Perú y que guarden mis datos solo para eso.</span></label>
          <p class="ferr" role="alert" aria-live="assertive"></p>
          <button class="bt dk fsub" type="submit"><span>Quiero que me avisen</span></button>
        </div>
      </form>
    </div>
  </div>
</section>
<script>
  import { PUBLIC_REGISTER_ENDPOINT } from 'astro:env/client';
  import { track, attribution } from '../../scripts/analytics';

  const form = document.querySelector<HTMLFormElement>('#rf');
  if (form) {
    const err = form.querySelector<HTMLElement>('.ferr')!;
    const btn = form.querySelector<HTMLButtonElement>('.fsub')!;
    const ok = form.querySelector<HTMLElement>('.fv-ok')!;
    const MSG: Record<string, string> = {
      name: 'Escribe tu nombre.',
      email: 'Revisa tu correo, parece que le falta algo.',
      role: 'Elige la opción que mejor te describe.',
      consent: 'Marca la casilla para que podamos escribirte.',
      rate_limited: 'Hay muchas personas registrándose ahora. Intenta de nuevo en un minuto.',
      offline: 'No pudimos conectarnos. Revisa tu internet e intenta de nuevo.',
      disabled: 'El registro abre en unas horas. Vuelve pronto.',
      server: 'Algo falló de nuestro lado. Intenta de nuevo en un momento.',
    };
    let started = false;
    form.addEventListener('input', () => {
      if (!started) { started = true; track('register_started'); }
      form.classList.remove('bad');
    }, { passive: true });

    const fail = (code: string, field?: string) => {
      err.textContent = MSG[code] ?? MSG.server;
      form.classList.add('bad');
      const target = field ? form.querySelector<HTMLElement>(`[name="${field}"]`) : null;
      target?.focus();
      if (!['name', 'email', 'role', 'consent'].includes(code)) track('register_failed', { reason: code });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.textContent = '';
      const fd = new FormData(form);
      const data = {
        name: String(fd.get('name') ?? '').trim(),
        email: String(fd.get('email') ?? '').trim(),
        role: String(fd.get('role') ?? ''),
        city: String(fd.get('city') ?? '').trim(),
        consent: fd.get('consent') === 'on',
        website: String(fd.get('website') ?? ''),
        page: location.pathname,
        ...attribution(),
      };
      if (data.name.length < 2) return fail('name', 'name');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email)) return fail('email', 'email');
      if (!data.role) return fail('role', 'role');
      if (!data.consent) return fail('consent', 'consent');
      if (!PUBLIC_REGISTER_ENDPOINT) {
        console.warn('[registro] PUBLIC_REGISTER_ENDPOINT is empty. See integrations/google-sheets/README.md.');
        return fail('disabled');
      }

      btn.disabled = true;
      form.classList.add('sending');
      try {
        const res = await fetch(PUBLIC_REGISTER_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(data) });
        const out = await res.json().catch(() => ({ ok: false, error: 'server' }));
        if (!out.ok) return fail(out.error ?? 'server', ['name', 'email', 'role', 'consent'].includes(out.error) ? out.error : undefined);
        track('register_succeeded', { role: data.role, has_city: Boolean(data.city), source: data.source, duplicate: Boolean(out.duplicate) });
        form.querySelector('[data-ok-email]')!.textContent = data.email;
        form.classList.remove('bad');
        form.classList.add('done');
        ok.hidden = false;
        ok.focus();
      } catch {
        fail(navigator.onLine ? 'server' : 'offline');
      } finally {
        btn.disabled = false;
        form.classList.remove('sending');
      }
    });

    form.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async () => {
      const shareUrl = location.origin + location.pathname + '?ref=share';
      const text = 'FlutterConf Perú 2026: sábado 19 de diciembre en Lima. Regístrate para que te avisen primero.';
      track('register_share');
      if (navigator.share) { try { await navigator.share({ title: 'FlutterConf Perú 2026', text, url: shareUrl }); } catch { /* cancelled */ } return; }
      await navigator.clipboard?.writeText(`${text} ${shareUrl}`);
      const c = form.querySelector<HTMLElement>('[data-copied]');
      if (c) { c.hidden = false; setTimeout(() => (c.hidden = true), 2500); }
    });
  }
</script>
