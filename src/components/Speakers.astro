---
/** Speaker fan (pinned on desktop: the 7 cards open as you scroll; a 2-column grid on phones). */
import Chicha from './Chicha.astro';
import Dash from './Dash.astro';
import { accent, FAN } from '../lib/palette';
import { list } from '../lib/content';
const speakers = await list('speakers');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="z" id="ponentes" style="--a:#3A0B91;--b:#3A0B91;padding:0">
  <div class="pin fan">
    <div class="stick">
      <div class="ttl"><span class="kick">Ponentes</span><h2><Chicha text={'¿Quién sube\nal escenario?'} /></h2></div>
      {speakers.map((s, i) => {
        const [x, y, r0, r1] = FAN[i % FAN.length];
        return (
          <article class="fc" style={`--k:${accent(i + 1)};--x:${x};--y:${y};--r0:${r0};--r1:${r1};z-index:${10 - Math.abs(i - 3)}`}>
            <div class="pp">
              <span class="pl">{s.place}</span>
              {s.photo ? <img class="photo" src={`${base}/${s.photo}`} alt={`Foto de ${s.name}`} loading="lazy" /> : <Dash flag={false} />}
            </div>
            <h3>{s.name === 'Por anunciar' ? s.role : s.name}</h3>
            <p>{s.talk}</p>
          </article>
        );
      })}
      <p class="note">Primeros nombres confirmados · revelamos uno nuevo cada semana</p>
    </div>
  </div>
</section>
