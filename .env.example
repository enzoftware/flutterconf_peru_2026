# Copy to .env and fill in. Never commit .env (it is git-ignored).
# For the deploy, add the same names as repository secrets
# (GitHub → Settings → Secrets and variables → Actions). The deploy workflow passes them to the build.
#
# Note: this is a static site, so these values end up in the public JS bundle. That is by design for both:
# - the PostHog project key (phc_…) is a write-only ingestion key, safe to expose;
# - the register endpoint is a Google Apps Script web app that only appends validated rows.
# Never put a PostHog personal API key (phx_…) or a Google service-account key here.

# PostHog project API key (Project settings → Project API key). Empty = analytics off.
PUBLIC_POSTHOG_KEY=
# PostHog ingestion host: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud).
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Apps Script web app URL that writes the sign-ups to the spreadsheet
# (ends in /exec). Setup: integrations/google-sheets/README.md. Empty = the form shows "not available yet".
PUBLIC_REGISTER_ENDPOINT=
