{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 2,
      "url": [
        "http://localhost/index.html",
        "http://localhost/brand/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 350000
          }
        ]
      }
    }
  }
}
