{
  "name": "flutterconf-peru-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing de FlutterConf Perú 2026 (Astro) y sistema de diseño Chicha Dash.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "tokens": "node brand/tools/tokens/build-tokens.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro check && astro build",
    "preview": "astro preview",
    "build:cf": "SITE_URL=https://flutterperu.com BASE_PATH=/ npm run build",
    "preview:cf": "wrangler dev",
    "deploy:cf": "npm run build:cf && wrangler deploy",
    "check": "astro check",
    "deck:pdf": "node scripts/deck-pdf.mjs",
    "social": "node scripts/social-images.mjs",
    "evidence": "node scripts/evidence.mjs",
    "test": "node --test src/lib/registration.test.ts integrations/google-sheets/Code.test.mjs",
    "check:keys": "node scripts/check-keys.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "wrangler": "4.156.2"
  },
  "allowScripts": {
    "workerd@1.20261102.1": true,
    "esbuild@0.28.2": true
  }
}
